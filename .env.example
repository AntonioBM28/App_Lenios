# ─── Leños Rellenos — Environment Variables ──────────────────────
# Copy this file to .env and fill in your values.
# Variables must be prefixed with VITE_ to be available in the browser.

# NestJS backend base URL (sin /api — el backend no usa prefijo global;
# cambia al dominio de producción cuando despliegues)
VITE_API_URL=http://localhost:3000

# Usar datos mock locales (true) o llamar a la API real (false)
VITE_USE_MOCK_DATA=false

# Número de WhatsApp del negocio para recibir pedidos (formato internacional sin + ni espacios)
VITE_WHATSAPP_NUMBER=524181873720

# Correo de contacto del negocio (usado en Contacto y en el Aviso de Privacidad para
# ejercer derechos ARCO)
VITE_CONTACT_EMAIL=contacto@lenosrellenos.com

# Preparado para una futura migración a cookies httpOnly (NO activar todavía:
# el backend aún no emite el token de sesión del admin como cookie).
# Cuando se coordine esa migración con backend, cambiar a true.
VITE_USE_COOKIE_AUTH=false
